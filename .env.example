# School Management System - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env FILE TO VERSION CONTROL

# Application
APP_NAME=school-management-system
APP_DISPLAY_NAME=School Management System
APP_SUBTITLE=Candidate Registry
APP_VENDOR=School Management System

# Server
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# Database (H2 file-based)
# For production, consider using PostgreSQL/MySQL instead
SPRING_DATASOURCE_URL=jdbc:h2:file:${HOME}/Documents/school-management/candidates;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# H2 Console (disable in production!)
SPRING_H2_CONSOLE_ENABLED=false

# Security - REQUIRED: Set strong passwords for default users
APP_ADMIN_PASSWORD=your_strong_admin_password_here
APP_SPECTATOR_PASSWORD=your_strong_spectator_password_here

# Data directory (optional, defaults to Documents/school-management)
APP_DATA_DIR=Documents/school-management